<!--pages/tools/compass.wxml-->
<view class="container">
  <block wx:if="{{isTip}}">
    <view class="text">
      <text>请您远离磁场干扰源</text>
      <text>并按下图所示校准指南针</text>
    </view>
    <image class="tip-pic" src="../../images/compass/tip.jpg"></image>
    <view class="tip-btn" bindtap="kown">我知道了</view>
  </block>

  <block wx:else>
    <view class="text">
      <text>{{direction}}</text>
      <text>{{angle}}°</text>
    </view>

    <!-- 盘面舞台：flex 居中，自适应剩余空间 -->
    <view class="stage" bindtap="switchStyle">
      <view class="compass">
        <!-- 顶部指向标，指示手机朝向 -->
        <view class="pointer"></view>

        <!-- 图片样式 -->
        <image wx:if="{{styles[styleIndex].type == 'image'}}" class="face" src="{{styles[styleIndex].src}}"
          style="transform: rotate({{rotate}}deg);"></image>

        <!-- 矢量盘面样式 -->
        <view wx:else class="dial" style="transform: rotate({{rotate}}deg);">
          <view wx:for="{{styles[styleIndex].circles}}" wx:for-item="d" wx:key="*this"
            class="circle" style="width:{{d}}rpx;height:{{d}}rpx;margin:-{{d/2}}rpx 0 0 -{{d/2}}rpx;"></view>

          <view wx:for="{{styles[styleIndex].rings}}" wx:for-item="r" wx:for-index="ri" wx:key="ri" class="ring">
            <view wx:for="{{r.items}}" wx:key="i" class="ring-item"
              style="transform: rotate({{item.deg}}deg) translateY(-{{r.radius}}rpx);">
              <text style="transform: rotate(-{{item.deg}}deg); font-size:{{r.fontSize}}rpx; color:{{item.color}};">{{item.c}}</text>
            </view>
          </view>

          <view wx:if="{{styles[styleIndex].needle}}" class="needle"></view>
          <view wx:if="{{styles[styleIndex].center == 'taiji'}}" class="taiji">
            <view class="taiji-dot taiji-dot-top"></view>
            <view class="taiji-dot taiji-dot-bottom"></view>
          </view>
          <view wx:if="{{styles[styleIndex].center == 'dot'}}" class="center-dot"></view>
        </view>
      </view>
    </view>

    <view class="hint">点击罗盘切换样式 · {{styles[styleIndex].name}}</view>
  </block>
</view>
